{
  "dashboard": {
    "id": null,
    "uid": "obs-master",
    "title": "Observability Master Dashboard",
    "timezone": "browser",
    "refresh": "5s",
    "time": {"from": "now-5m", "to": "now"},
    "panels": [
      {
        "id": 1,
        "title": "🥧 Entrypoint REST Síncrono: GET /users/{userId}",
        "description": "Decomposição do tempo total de resposta da API REST. A pizza inteira representa 100% do tempo gasto por quem invocou o endpoint, fatiada pelas integrações e regras internas.",
        "type": "piechart",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 9},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(flow_slice_duration_seconds_sum{flow=\"GET /api/v1/orchestrator/users/{userId}\"}[1m])) by (step)",
            "legendFormat": "{{step}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "options": {
          "pieType": "donut",
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "values": ["percent", "value"]
          },
          "tooltip": {"mode": "single"}
        }
      },
      {
        "id": 2,
        "title": "🥧 Entrypoint Assíncrono: Consumidor Kafka (user-registration-topic)",
        "description": "Decomposição do tempo total de execução do consumidor de eventos. A pizza inteira representa 100% do ciclo de consumo, fatiada pelas integrações de APIs e filas de mensageria.",
        "type": "piechart",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 9},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(flow_slice_duration_seconds_sum{flow=\"Kafka Consumer: user-registration-topic\"}[1m])) by (step)",
            "legendFormat": "{{step}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "options": {
          "pieType": "donut",
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "values": ["percent", "value"]
          },
          "tooltip": {"mode": "single"}
        }
      },
      {
        "id": 3,
        "title": "⚡ Circuit Breaker: Customer Service",
        "type": "stat",
        "gridPos": {"x": 0, "y": 9, "w": 8, "h": 4},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "resilience4j_circuitbreaker_state{group=\"none\", name=\"customer-service\", state=\"closed\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"color": "red", "text": "🔴 ABERTO"}, "1": {"color": "green", "text": "🟢 FECHADO"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "textMode": "value",
          "reduceOptions": {"calcs": ["lastNotNull"]}
        }
      },
      {
        "id": 4,
        "title": "⚡ Circuit Breaker: Billing Service",
        "type": "stat",
        "gridPos": {"x": 8, "y": 9, "w": 8, "h": 4},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "resilience4j_circuitbreaker_state{group=\"none\", name=\"billing-service\", state=\"closed\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"color": "red", "text": "🔴 ABERTO"}, "1": {"color": "green", "text": "🟢 FECHADO"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "textMode": "value",
          "reduceOptions": {"calcs": ["lastNotNull"]}
        }
      },
      {
        "id": 5,
        "title": "⚡ Circuit Breaker: Notification Service",
        "type": "stat",
        "gridPos": {"x": 16, "y": 9, "w": 8, "h": 4},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "resilience4j_circuitbreaker_state{group=\"none\", name=\"notification-service\", state=\"closed\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"color": "red", "text": "🔴 ABERTO"}, "1": {"color": "green", "text": "🟢 FECHADO"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "textMode": "value",
          "reduceOptions": {"calcs": ["lastNotNull"]}
        }
      },
      {
        "id": 6,
        "title": "⏱ Latência E2E do Fluxo GET no Tempo",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 13, "w": 12, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(flow_total_duration_seconds_sum{flow=\"GET /api/v1/orchestrator/users/{userId}\"}[1m])) / sum(rate(flow_total_duration_seconds_count{flow=\"GET /api/v1/orchestrator/users/{userId}\"}[1m]))",
            "legendFormat": "E2E Média Real (s)",
            "refId": "A"
          },
          {
            "expr": "flow_total_duration_seconds_max{flow=\"GET /api/v1/orchestrator/users/{userId}\"}",
            "legendFormat": "E2E Pico Máx (s)",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {"lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme", "showPoints": "never"}
          }
        },
        "options": {"tooltip": {"mode": "multi"}}
      },
      {
        "id": 7,
        "title": "📊 Taxa de Erros por Integração (%)",
        "type": "stat",
        "gridPos": {"x": 12, "y": 13, "w": 6, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(resilience4j_circuitbreaker_calls_seconds_count{group=\"none\", name=~\"customer-service|billing-service|notification-service\", kind=\"failed\"}[5m])) by (name) / (sum(rate(resilience4j_circuitbreaker_calls_seconds_count{group=\"none\", name=~\"customer-service|billing-service|notification-service\", kind=\"successful\"}[5m])) by (name) + sum(rate(resilience4j_circuitbreaker_calls_seconds_count{group=\"none\", name=~\"customer-service|billing-service|notification-service\", kind=\"failed\"}[5m])) by (name)) * 100",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "textMode": "value_and_name",
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "orientation": "vertical"
        }
      },
      {
        "id": 8,
        "title": "🎯 Throughput das Integrações (req/s)",
        "type": "stat",
        "gridPos": {"x": 18, "y": 13, "w": 6, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(resilience4j_circuitbreaker_calls_seconds_count{group=\"none\", name=~\"customer-service|billing-service|notification-service\"}[1m])) by (name)",
            "legendFormat": "{{name}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "thresholds": {
              "mode": "absolute",
              "steps": [{"color": "blue", "value": null}]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "textMode": "value_and_name",
          "reduceOptions": {"calcs": ["lastNotNull"]},
          "orientation": "vertical"
        }
      },
      {
        "id": 9,
        "title": "📦 Lag Real do Kafka por Tópico (Mensagens Pendentes)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(kafka_consumer_lag_records) by (topic)",
            "legendFormat": "{{topic}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"lineWidth": 2, "fillOpacity": 25, "gradientMode": "scheme", "showPoints": "never"}
          }
        },
        "options": {"tooltip": {"mode": "multi"}}
      },
      {
        "id": 10,
        "title": "📨 Profundidade de Filas SQS (Mensagens Acumuladas)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sqs_queue_depth",
            "legendFormat": "{{queue}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"lineWidth": 2, "fillOpacity": 25, "gradientMode": "scheme", "showPoints": "never"}
          }
        },
        "options": {"tooltip": {"mode": "multi"}}
      },
      {
        "id": 11,
        "title": "📤 Taxa de Produção (msg/s)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 27, "w": 8, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(messaging_produce_seconds_count[1m])) by (method)",
            "legendFormat": "{{method}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {"lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme", "showPoints": "never"}
          }
        },
        "options": {"tooltip": {"mode": "multi"}}
      },
      {
        "id": 12,
        "title": "📥 Taxa de Consumo (msg/s)",
        "type": "timeseries",
        "gridPos": {"x": 8, "y": 27, "w": 8, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(messaging_consume_seconds_count[1m])) by (method)",
            "legendFormat": "{{method}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {"lineWidth": 2, "fillOpacity": 15, "gradientMode": "scheme", "showPoints": "never"}
          }
        },
        "options": {"tooltip": {"mode": "multi"}}
      },
      {
        "id": 13,
        "title": "💳 Proporção de Planos de Cobrança",
        "type": "piechart",
        "gridPos": {"x": 16, "y": 27, "w": 8, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(increase(user_profile_provision_seconds_count[1h])) by (billing_type)",
            "legendFormat": "{{billing_type}}",
            "refId": "A"
          }
        ],
        "options": {
          "pieType": "donut",
          "legend": {"displayMode": "table", "placement": "right", "values": ["percent"]}
        }
      },
      {
        "id": 14,
        "title": "🚨 Central de Alarmística e Violações de SLA (Alerts/sec)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 34, "w": 16, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(alerts_triggered_total[1m])) by (type, severity)",
            "legendFormat": "[{{severity}}] {{type}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}
        }
      },
      {
        "id": 15,
        "title": "⚠️ Incidentes e Violações por Alvo",
        "type": "barchart",
        "gridPos": {"x": 16, "y": 34, "w": 8, "h": 7},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(increase(alerts_triggered_total[15m])) by (target)",
            "legendFormat": "{{target}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 16,
        "title": "🛑 Ponto Exato de Interrupção de Fluxos (Dead Stop Breakdown)",
        "type": "barchart",
        "gridPos": {"x": 0, "y": 41, "w": 14, "h": 8},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(increase(flow_interruption_total[15m])) by (failed_step, error_type)",
            "legendFormat": "{{failed_step}} [{{error_type}}]",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"]}
        }
      },
      {
        "id": 17,
        "title": "🔍 Auditoria de Quebras por Step e Causa Raiz",
        "type": "table",
        "gridPos": {"x": 14, "y": 41, "w": 10, "h": 8},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum by (flow, failed_step, error_type) (flow_interruption_total)",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "options": {
          "sortBy": [{"displayName": "Value", "desc": true}]
        }
      },
      {
        "id": 18,
        "title": "📜 Live Stream de Logs das Legs (Loki & Auditoria de Payloads Mascarados)",
        "description": "Stream em tempo real de todas as pernas de comunicação (INBOUND e OUTBOUND). Payloads sensíveis chegam aqui pré-mascarados via SpEL, com rastreabilidade direta para o trace distribuído (Jaeger).",
        "type": "logs",
        "gridPos": {"x": 0, "y": 49, "w": 24, "h": 12},
        "datasource": {"type": "loki", "uid": "loki-logs"},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "loki-logs"},
            "expr": "{app=\"user-orchestrator\", leg_type=~\"INBOUND|OUTBOUND\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showLabels": true,
          "wrapLogMessage": true,
          "enableLogDetails": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 19,
        "title": "📊 Volume de Pernas de Execução por Alvo e Fase",
        "description": "Distribuição de requisições e respostas tratadas por cada cliente/controlador interceptado pelo LogLeg.",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 61, "w": 12, "h": 8},
        "datasource": {"type": "loki", "uid": "loki-logs"},
        "targets": [
          {
            "datasource": {"type": "loki", "uid": "loki-logs"},
            "expr": "sum(count_over_time({app=\"user-orchestrator\", leg_target!=\"none\"}[1m])) by (leg_target, leg_phase)",
            "legendFormat": "{{leg_target}} [{{leg_phase}}]",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"]}
        }
      },
      {
        "id": 20,
        "title": "⏱️ Latência por Perna de Comunicação (Métrica Log-derived via Loki / Prometheus)",
        "description": "Medição contínua da latência das integrações por p95/média.",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 61, "w": 12, "h": 8},
        "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
        "targets": [
          {
            "expr": "sum(rate(flow_slice_duration_seconds_sum{step=~\"step.api.*\"}[1m])) by (step) / sum(rate(flow_slice_duration_seconds_count{step=~\"step.api.*\"}[1m])) by (step)",
            "legendFormat": "Média Latência: {{step}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        },
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}
        }
      }
    ]
  },
  "overwrite": true
}