<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <groupId>com.empresa.platform</groupId>
    <artifactId>corporate-observability-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>corporate-observability-parent</name>
    <description>Corporate Observability Platform Root POM</description>

    <modules>
        <module>observability-api</module>
        <module>observability-core</module>
        <module>observability-autoconfigure</module>
        <module>observability-spring-boot-starter</module>
        <module>observability-test</module>
        <module>observability-legacy-compat</module>
        <module>observability-demo</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.0</spring-cloud.version>
        <opentelemetry.version>1.35.0</opentelemetry.version>
        <context-propagation.version>1.1.1</context-propagation.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>3.1.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>observability-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>observability-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>observability-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>observability-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>observability-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>observability-legacy-compat</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
